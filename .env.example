# ─────────────────────────────────────────────────────────────
# Nimantran environment variables
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local`. Variables starting with NEXT_PUBLIC_
# are sent to the browser; everything else stays on the server.
# ─────────────────────────────────────────────────────────────

# Public URL of the site, used for share links, OG images and QR codes.
# Local: http://localhost:3000   Production: https://nimantran.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Phase 2) ── Supabase dashboard → Project Settings → API
# Project URL (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / publishable key (safe to expose; Row Level Security protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key. SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay (Phase 6) ── Razorpay dashboard → Account & Settings → API Keys (use Test Mode first)
# Key ID (starts with rzp_test_ / rzp_live_). Public, used by the checkout widget.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Key secret. SERVER ONLY. Used to create orders and verify payment signatures.
RAZORPAY_KEY_SECRET=
# Webhook secret you choose when creating the webhook in Razorpay. SERVER ONLY.
RAZORPAY_WEBHOOK_SECRET=

# ── Security (Phase 2+) ──
# Random string used to sign guest tokens / rate-limit keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
